# Default: let Git detect text and normalize line endings.
* text=auto

# Unreal source and project files stay as text.
*.cpp text diff=cpp
*.h text
*.c text
*.hpp text
*.cs text
*.usf text
*.ush text
*.uproject text
*.uplugin text
*.ini text
*.json text
*.md text

# Unreal assets. These are binary and often exceed GitHub's 100 MB limit.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
*.uptnl filter=lfs diff=lfs merge=lfs -text
*.ufont filter=lfs diff=lfs merge=lfs -text

# Raw media you may keep next to the project before import.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
