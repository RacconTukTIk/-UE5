# Unreal Engine 5
# Based on https://github.com/github/gitignore/blob/main/UnrealEngine.gitignore

# Visual Studio user-specific files
.vs/
.vscode/
.vsconfig

# JetBrains Rider
.idea/
*.DotSettings.user

# Compiled object files
*.slo
*.lo
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Compiled dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled static libraries
*.lai
*.la
*.a
*.lib

# Executables and debug symbols
*.exe
*.out
*.app
*.ipa
*.pdb
*.idb
*.ipdb
*.iobj

# Project files generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.code-workspace

# Precompiled assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary and generated folders (any depth, including plugins)
Binaries/
**/Binaries/
Build/
**/Build/
DerivedDataCache/
**/DerivedDataCache/
Intermediate/
**/Intermediate/
Saved/
**/Saved/

# Keep pak blacklist and icons that live under Build
!**/Build/*/
!**/Build/*/PakBlacklist*.txt
!**/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Editor caches and local working dirs
FileOpenOrder/
ShaderDebugInfo/
enc_temp_folder/
*.tmp

# Packaged / staged output
PackagedBuilds/
ArchivedBuilds/
StagedBuilds/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Python cache (editor Python scripts)
__pycache__/
*.pyc
